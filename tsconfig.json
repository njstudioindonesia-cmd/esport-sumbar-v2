{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@esport-sumbar/contracts": ["./packages/contracts/src"],
      "@esport-sumbar/lib": ["./packages/lib/src"],
      "@esport-sumbar/config": ["./packages/config"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "services/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
