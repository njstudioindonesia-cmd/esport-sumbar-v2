{
  "name": "esport-sumbar-monorepo",
  "version": "3.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "audit:secrets": "node scripts/scan-secrets.js",
    "audit:terms": "node scripts/sweep-terms.js"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "vitest": "^3.0.0"
  }
}
